# 이 파일을 .env로 복사한 뒤 로컬/운영 환경 값을 설정하세요.

# 외부에 공개할 웹 서비스 포트 (Nginx가 / 와 /api/ 를 모두 제공합니다)
WEB_PORT=8080

# API 컨테이너(/models/checkpoint)에 읽기 전용으로 마운트할 모델 체크포인트 폴더.
# 존재하지 않는 경로를 지정하면 빈 디렉터리를 자동 생성하지 않고 실행을 중단합니다.
EMOTION_MODEL_PATH=./tmp

# 실제 9감정 앙상블 환경에서는 0을 유지하세요. (계약 mock 검증 시에만 1)
EMOTION_MOCK_MODE=0

# PostgreSQL RDBMS 컨테이너 설정
POSTGRES_DB=moment
POSTGRES_USER=moment
POSTGRES_PASSWORD=change-this-postgres-password

# JWT 인증 및 쿠키 보안 설정 (운영 환경에서는 반드시 32바이트 이상 랜덤 시크릿으로 교체)
JWT_SECRET_KEY=change-this-jwt-secret-key-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=0
CONSENT_HASH_SALT=change-this-consent-hash-salt
